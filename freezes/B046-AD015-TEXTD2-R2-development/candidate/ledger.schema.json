{
  "type": "object",
  "properties": {
    "source_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "EXAMINED",
              "NOT_EXAMINED",
              "INACCESSIBLE",
              "COVERAGE_UNCLEAR"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "sha256",
          "state",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "run_record": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_version": {
          "const": "0.4.6"
        },
        "amendment_id": {
          "const": "PB-R2-REPAIR"
        },
        "instrument_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wrapper_version": {
          "const": "B046-TEXTD2"
        },
        "wrapper_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_spec_version": {
          "const": "0.1.5"
        },
        "admission_spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "apk_id": {
          "type": "string",
          "minLength": 1
        },
        "apk_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cdm_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "representation": {
          "const": "EXACT_TEXT_UTF8"
        },
        "source_completeness": {
          "enum": [
            "RECONCILED_AS_DECLARED",
            "UNVERIFIED",
            "KNOWN_INCOMPLETE"
          ]
        },
        "reviewer_provider": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_model": {
          "type": "string",
          "minLength": 1
        },
        "design_participation": {
          "enum": [
            "DPS0",
            "DPS1",
            "DPS2",
            "DPS3",
            "DPSX"
          ]
        },
        "corpus_exposure": {
          "enum": [
            "DESIGN_EXPOSED",
            "POSSIBLY_DESIGN_EXPOSED",
            "HELD_OUT_NO_KNOWN_DESIGN_EXPOSURE",
            "UNKNOWN"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string",
          "minLength": 1
        },
        "tools_available": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_access": {
          "const": "NONE"
        },
        "completion": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "run_id",
        "instrument_version",
        "amendment_id",
        "instrument_sha256",
        "schema_sha256",
        "wrapper_version",
        "wrapper_sha256",
        "admission_spec_version",
        "admission_spec_sha256",
        "apk_id",
        "apk_sha256",
        "admission_report_sha256",
        "cdm_sha256",
        "representation",
        "source_completeness",
        "reviewer_provider",
        "reviewer_model",
        "design_participation",
        "corpus_exposure",
        "started_at",
        "completed_at",
        "tools_available",
        "external_access",
        "completion",
        "limitations"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "EXAMINED_NO_CANDIDATE",
              "EXAMINED_WITH_CANDIDATES",
              "EXAMINED_CONTEXT_ONLY",
              "NOT_EXAMINED",
              "INACCESSIBLE",
              "COVERAGE_UNCLEAR"
            ]
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PE[0-9]{6,}$"
            },
            "uniqueItems": true
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "node_id",
          "content_sha256",
          "state",
          "event_ids",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "protocol_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error_id": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^PE[0-9]{6,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_type": {
            "type": "string",
            "minLength": 1
          },
          "original_value": {},
          "corrected_value": {},
          "status": {
            "enum": [
              "OPEN",
              "CORRECTED"
            ]
          },
          "re_evaluation": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "NOT_REEVALUATED",
                  "REEVALUATED"
                ]
              },
              "record": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "state",
              "record"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error_id",
          "event_id",
          "error_type",
          "original_value",
          "corrected_value",
          "status",
          "re_evaluation"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "positive_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage1_no_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage1_unclear_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage2_unresolved_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "candidate_count",
        "positive_finding_count",
        "unresolved_count",
        "stage1_no_count",
        "stage1_unclear_count",
        "stage2_unresolved_count"
      ],
      "additionalProperties": false
    },
    "global_assessment": {
      "type": "object",
      "properties": {
        "label": {
          "enum": [
            "PB-G0",
            "PB-G1",
            "PB-G2",
            "PB-G3",
            "PB-GX"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "supporting_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PE[0-9]{6,}$"
          },
          "uniqueItems": true
        },
        "coverage_limitation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_sufficient": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "rationale",
        "supporting_event_ids",
        "coverage_limitation",
        "coverage_sufficient"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "source_coverage",
    "run_record",
    "events",
    "coverage",
    "protocol_errors",
